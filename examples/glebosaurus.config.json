// Wzór pliku konfiguracji agenta Glebosaurus (komentarze i końcowe przecinki są dozwolone). Skopiuj jako
// glebosaurus.config.json obok bazy agenta i uzupełnij sekcję "cloud". Czujniki, progi, harmonogram raportów, odbiorcy
// maili, klucze Tuya i hasło Gmaila są w chmurze (Supabase) – ustawia je właściciel na stronie w chmurze (Konfiguracja).
// Tu tylko dostęp do chmury i ustawienia tego urządzenia.
// Rejestracja agenta: glebosaurus enroll --config <ten plik> (jednorazowy kod od właściciela), potem glebosaurus run.
{
  "cloud": {
    // Adres projektu Supabase i jego klucz publikowalny (sb_publishable_…, ten sam dla wszystkich agentów).
    // Nigdy nie wpisuj tu klucza tajnego (sb_secret_…) ani hasła bazy.
    "url": "https://abcdefghijklmnopqrst.supabase.co",
    "publishableKey": "sb_publishable_…"
    // Opcjonalnie (domyślne obok tego pliku): "tokenFile": "glebosaurus-cloud.token",
    //                                          "configCacheFile": "glebosaurus-cloud-config.bin"

    // Codzienna kopia zapasowa chmury – tylko na JEDNYM zaufanym agencie (najlepiej tym, który pracuje stale). adminFile to
    // plik jak cloud-admin.json, ale wystarczy w nim supabase.url i supabase.databasePassword (bez klucza tajnego).
    // Kopie zawierają odszyfrowane klucze Tuya i hasło Gmaila – są sekretem.
    // , "backup": { "adminFile": "cloud-admin.json", "directory": "backups", "keep": 14 }
  },

  // Nazwa agenta w dzienniku i certyfikacie panelu, zanim przyjdzie konfiguracja z chmury (potem: nazwa z chmury).
  // "monitorName": "salon",

  // Lokalny bufor i kopia odczytów (SQLite); ścieżka względna od katalogu tego pliku.
  "database": "glebosaurus.db",
  "retentionDays": 400,

  // Dziennik agenta (pliki dzienne w logs/); wczorajszy trafia do chmury, a nadawca wysyła go administratorowi.
  "logs": { "retentionDays": 7 }

  // Agent bez Bluetooth – np. Raspberry Pi stojący daleko od czujników jako sam nadawca maili (rola nadawcy:
  // cloud agent --sender-priority 1). Nie otwiera Bluetooth, nie słucha i nie czyta czujników; synchronizuje się z
  // chmurą, wysyła do niej swój dziennik i maile. Domyślnie true (agent czyta czujniki, które słyszy).
  // , "bluetooth": false

  // Panel WWW w sieci lokalnej (HTTPS, hasło: glebosaurus web-password): pulpit z odczytami wszystkich agentów, kto czyta
  // który czujnik, nadawca maili; odczyt i raport na żądanie idą poleceniem przez chmurę. Żeby włączyć, usuń komentarz.
  // , "web": {
  //   "port": 8470,                    // port HTTPS (1024–65535); adres: https://<nazwa-komputera>:8470/
  //   "allowedNetworks": [],           // np. ["192.168.1.0/24"]; puste = wszystkie sieci prywatne (loopback zawsze)
  //   "sessionHours": 12               // jak długo ważne jest zalogowanie (restart agenta i tak wylogowuje)
  // }
}
