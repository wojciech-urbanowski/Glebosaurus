    "publishableKey": "sb_publishable_…",                 // potrzebny do kodu QR rejestracji telefonu (cloud agent --qr)
    "databasePassword": "HASLO_BAZY",                     // Project Settings → Database (hasło ustawione przy zakładaniu projektu)
    // Pooler sesji Twojego regionu (Connect → Session pooler); domyślnie Central EU (Frankfurt):
    "databaseHost": "aws-1-eu-central-1.pooler.supabase.com"
    // "secretKey": "sb_secret_…"                          // niepotrzebny programowi; jeśli trzymasz go tutaj – nigdy na agentach
  }
  // Konfigurację (poczta, czujniki, progi, raporty, strażnik healthchecks.io) ustawia się na stronie w chmurze –
