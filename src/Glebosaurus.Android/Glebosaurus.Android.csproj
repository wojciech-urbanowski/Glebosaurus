<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Agent na Androida (faza 2.2, ARCHITEKTURA.md zasada 12): tylko zbieranie w trybie chmurowym – ten sam protokół Tuya,
    zbieracz, synchronizacja i bufor SQLite co na Windows; tu tylko radio BLE na API Androida, usługa pierwszoplanowa i ekran.
    Poza Glebosaurus.slnx, bo wymaga obciążenia „android” (dotnet workload install android), JDK i Android SDK.
    Budowanie: deploy/build-android.ps1 (APK podpisany kluczem wydań, jeśli jest), w CI – .github/workflows (zadanie android).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 10+: typ usługi pierwszoplanowej i siła sygnału Wi-Fi z NetworkCapabilities. Mi 11 Lite 5G: Android 11–14. -->
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Glebosaurus.Android</RootNamespace>
    <AssemblyName>Glebosaurus.Android</AssemblyName>
    <ApplicationId>pl.glebosaurus.agent</ApplicationId>
    <ApplicationTitle>Glebosaurus</ApplicationTitle>
    <!-- Wersja z Directory.Build.props; kod wersji rośnie z nią: 0.2.1 → 201 (Android nie pozwala zainstalować starszego kodu). -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Minor), 100)))), $([System.Version]::Parse('$(Version)').Build)))</ApplicationVersion>
    <!-- Jeden APK dla współczesnych telefonów (arm64), bez paczki AAB – instalacja z pliku, nie ze Sklepu Play. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Przycinane tylko biblioteki platformy; nasze (konfiguracja, SQLite, protokół) zostają całe. -->
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Klucz wydań: deploy/build-android.ps1 i CI podają plik i hasło (zmienna środowiska) – w repozytorium go nie ma. -->
  <PropertyGroup Condition="'$(GlebosaurusKeystore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(GlebosaurusKeystore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>glebosaurus</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:GLEBOSAURUS_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:GLEBOSAURUS_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <!-- Skaner kodów QR z Usług Google Play: własny ekran aparatu, bez uprawnienia do aparatu w aplikacji. -->
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.17" />
    <ProjectReference Include="..\Glebosaurus.Tuya\Glebosaurus.Tuya.csproj" />
    <ProjectReference Include="..\Glebosaurus.Core\Glebosaurus.Core.csproj" />
    <ProjectReference Include="..\Glebosaurus.Data\Glebosaurus.Data.csproj" />
    <ProjectReference Include="..\Glebosaurus.Cloud\Glebosaurus.Cloud.csproj" />
  </ItemGroup>

</Project>
