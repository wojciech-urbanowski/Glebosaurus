<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows: net10.0-windows10.0.19041.0 (WinRT przez Shiny.BluetoothLE). Linux/Raspberry Pi: net10.0 (BlueZ przez Shiny.BluetoothLE.Linux).
       Publikacja: -f net10.0-windows10.0.19041.0 -r win-x64   albo   -f net10.0 -r linux-arm64 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <AssemblyName>glebosaurus</AssemblyName>
    <RootNamespace>Glebosaurus.Agent</RootNamespace>
    <!-- Bez zależności od ICU (np. na Raspberry Pi OS Lite), jak w LibrusNotifier. Strefa czasowa: tzdata (Linux) lub rejestr (Windows). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.BluetoothLE" Version="6.6.0" />
    <PackageReference Include="Shiny.BluetoothLE.Linux" Version="6.6.0" Condition="!$(TargetFramework.Contains('windows'))" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <!-- Kod QR rejestracji telefonu (cloud agent z opcją qr). -->
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <ProjectReference Include="..\Glebosaurus.Tuya\Glebosaurus.Tuya.csproj" />
    <ProjectReference Include="..\Glebosaurus.Core\Glebosaurus.Core.csproj" />
    <ProjectReference Include="..\Glebosaurus.Data\Glebosaurus.Data.csproj" />
    <ProjectReference Include="..\Glebosaurus.Mail\Glebosaurus.Mail.csproj" />
    <ProjectReference Include="..\Glebosaurus.Web\Glebosaurus.Web.csproj" />
    <ProjectReference Include="..\Glebosaurus.Cloud\Glebosaurus.Cloud.csproj" />
    <ProjectReference Include="..\Glebosaurus.Cloud.Admin\Glebosaurus.Cloud.Admin.csproj" />
  </ItemGroup>

</Project>
