<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Narzędzia właściciela chmury (faza 2.1): połączenie z bazą Supabase hasłem bazy przez pooler sesji i migracje schematu.
    Tylko komputer właściciela (import, migracje, kopia zapasowa) – agenci rozmawiają z chmurą przez Data API, bez Npgsql.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Glebosaurus.Cloud.Admin</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="11.0.0" />
    <ProjectReference Include="..\Glebosaurus.Core\Glebosaurus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glebosaurus.Tests" />
    <InternalsVisibleTo Include="Glebosaurus.Cloud.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\supabase\migrations\*.sql" LogicalName="Glebosaurus.Migrations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\supabase\prod-ca-2021.crt" LogicalName="Glebosaurus.Supabase.prod-ca-2021.crt" />
  </ItemGroup>

</Project>
